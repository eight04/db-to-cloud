{
  "name": "db-to-cloud",
  "version": "0.8.1",
  "description": "Synchronize your database with a cloud drive i.e. Dropbox, Google Drive, OneDrive, Github, etc.",
  "author": "eight04 <eight04@gmail.com>",
  "license": "MIT",
  "keywords": [
    "github",
    "google drive",
    "dropbox",
    "onedrive"
  ],
  "scripts": {
    "lint": "eslint . --cache",
    "test": "npm run lint && c8 --reporter=lcov node --test --test-isolation=none test/test.js",
    "preversion": "npm test",
    "version": "npm run build && git add .",
    "postversion": "git push --follow-tags && npm publish",
    "build": "rollup -c"
  },
  "main": "index.js",
  "dependencies": {
    "@eight04/read-write-lock": "^0.1.0",
    "universal-base64": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "assert-set": "^0.1.0",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "c8": "^12.0.0",
    "clipboardy": "^5.3.2",
    "core-js-pure": "^3.50.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "form-data": "^4.0.6",
    "globals": "^17.12.0",
    "make-fetch-happen": "^16.0.1",
    "rollup": "^4.63.3",
    "rollup-plugin-cjs-es": "^3.0.0",
    "rollup-plugin-re": "^1.0.7",
    "sinon": "^22.1.0",
    "tempdir-yaml": "^0.4.0",
    "webdav-server": "^2.6.3"
  },
  "repository": "eight04/db-to-cloud",
  "eslintIgnore": [
    "coverage",
    "dist"
  ],
  "engines": {
    "node": ">=8"
  },
  "files": [
    "lib",
    "dist"
  ],
  "unpkg": "dist/db-to-cloud.min.js",
  "overrides": {
    "@babel/core": "^8.0.5"
  },
  "type": "commonjs"
}
